{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": ["custom.regex"],

  "dependencyDashboard": true,
  "labels": ["deps:ami-update", "k8s", "security"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Bump Karpenter/EKS AL2023 alias like al2023@vYYYYMMDD",
      "managerFilePatterns": ["/.*\\.(tf|tfvars|ya?ml)$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)versioning=loose\\s[\\s\\S]*?al2023@(?<currentValue>v\\d{8})"
      ],
      "datasourceTemplate": "{{{datasource}}}",
      "depNameTemplate": "{{{depName}}}",
      "autoReplaceStringTemplate": "al2023@{{{newValue}}}"
    }
  ],
  "commitMessagePrefix": "RENOVATION",

  "packageRules": [
    {
      "matchDatasources": ["github-releases"],
      "matchDepNames": ["awslabs/amazon-eks-ami"],
      "groupName": "EKS AL2023 AMI release",
      "minimumReleaseAge": "2 days",
      "internalChecksFilter": "strict",
      "assignees": ["@murshed-panorama"],
      "labels": ["deps:ami-update"]
    }
  ]
}
